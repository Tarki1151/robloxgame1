{
  "name": "robloxgame1",
  "globIgnorePaths": [
    "**/.package-lock.json"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Ambient": [
          10,
          10,
          14
        ],
        "OutdoorAmbient": [
          28,
          26,
          34
        ],
        "Brightness": 1.6,
        "ClockTime": 18.5,
        "GeographicLatitude": 12,
        "ExposureCompensation": 0,
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 0.4,
        "GlobalShadows": true,
        "ShadowSoftness": 0.35,
        "FogEnd": 900,
        "FogStart": 120,
        "FogColor": [
          26,
          22,
          30
        ]
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.28,
          "Offset": 0.1,
          "Color": [
            150,
            142,
            148
          ],
          "Decay": [
            70,
            60,
            68
          ],
          "Glare": 0,
          "Haze": 0.2
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.45,
          "Size": 24,
          "Threshold": 2
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.06,
          "Spread": 0.6
        }
      },
      "ColorGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": -0.02,
          "Contrast": 0.16,
          "Saturation": 0.08,
          "TintColor": [
            255,
            246,
            240
          ]
        }
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}